{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "baseUrl": "src",
    "paths": {
      "@screens/*": ["screens/*"],
      "@assets/*": ["../assets/*"],
      "@hooks": ["hooks/"],
      "@components": ["components/"],
      "@types": ["types/"],
      "@utils": ["utils/"],
      "@schemas": ["schemas/"],
      "@store": ["store/"],
      "@layout": ["layout/"]
    }
  }
}
